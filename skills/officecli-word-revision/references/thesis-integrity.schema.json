{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit thesis integrity contract, structural evidence only",
  "type": "object",
  "required": ["schema_version", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "unlocked": {"type": "boolean"},
        "minimum_zotero_items": {"type": "integer", "minimum": 0},
        "zotero_bibliographies": {"type": "integer", "minimum": 0},
        "toc": {
          "type": "object", "additionalProperties": false,
          "required": ["contents", "figures", "tables", "figure_label", "table_label"],
          "properties": {
            "contents": {"type": "integer", "minimum": 0},
            "figures": {"type": "integer", "minimum": 0},
            "tables": {"type": "integer", "minimum": 0},
            "figure_label": {"$ref": "#/$defs/nonempty"},
            "table_label": {"$ref": "#/$defs/nonempty"},
            "figure_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
            "table_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
          }
        }
      }
    },
    "footnotes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "position": {"enum": ["pageBottom", "beneathText"]},
        "restart": {"enum": ["eachPage", "eachSect", "continuous"]},
        "minimum_count": {"type": "integer", "minimum": 0},
        "superscript": {"type": "boolean"}
      }
    },
    "captions": {"type": "array", "items": {"$ref": "#/$defs/caption"}},
    "caption_sequence_complete": {"type": "boolean"},
    "bibliography": {
      "type": "object", "additionalProperties": false,
      "required": ["heading", "group_order", "entries"],
      "properties": {
        "heading": {"$ref": "#/$defs/anchor"},
        "group_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bibliographyEntry"}},
        "entries_separate_paragraphs": {"type": "boolean"}
      }
    },
    "objects": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "inline_images": {"type": "boolean"},
        "tables": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["anchor"],
            "properties": {
              "anchor": {"$ref": "#/$defs/anchor"},
              "zero_indents": {"type": "boolean"},
              "growing_rows": {"type": "boolean"},
              "repeat_header": {"type": "boolean"},
              "plain_header": {"type": "boolean"},
              "han_left_nonhan_right": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "anchor": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["bookmark"], "properties": {"bookmark": {"$ref": "#/$defs/nonempty"}}},
        {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"$ref": "#/$defs/nonempty"}}}
      ]
    },
    "pageNumber": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "format": {"enum": ["roman", "lowerRoman", "upperRoman", "decimal"]},
        "start": {"oneOf": [{"const": "continue"}, {"type": "integer", "minimum": 1}]}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["id", "anchor"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "anchor": {"$ref": "#/$defs/anchor"},
        "kind": {"enum": ["cover", "declaration", "abstract_zh", "abstract_en", "contents", "figures", "tables", "chapter", "references", "acknowledgements", "appendix"]},
        "start": {"enum": ["any", "new_page", "new_section"]},
        "section": {"type": "integer", "minimum": 1},
        "page_number": {"$ref": "#/$defs/pageNumber"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["section"],
      "properties": {
        "section": {"type": "integer", "minimum": 1},
        "start_type": {"enum": ["continuous", "nextPage", "oddPage", "evenPage", "nextColumn"]},
        "orientation": {"enum": ["portrait", "landscape"]},
        "title_page": {"type": "boolean"},
        "page_number": {"$ref": "#/$defs/pageNumber"},
        "stories": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "header_default": {"enum": ["linked", "independent", "empty"]},
            "header_even": {"enum": ["linked", "independent", "empty"]},
            "header_first": {"enum": ["linked", "independent", "empty"]},
            "footer_default": {"enum": ["linked", "independent", "empty"]},
            "footer_even": {"enum": ["linked", "independent", "empty"]},
            "footer_first": {"enum": ["linked", "independent", "empty"]}
          }
        }
      }
    },
    "caption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "chapter", "number", "caption", "object"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "kind": {"enum": ["figure", "table"]},
        "label": {"$ref": "#/$defs/nonempty"}, "chapter": {"type": "integer", "minimum": 1},
        "number": {"type": "integer", "minimum": 1},
        "caption": {"$ref": "#/$defs/anchor"}, "object": {"$ref": "#/$defs/anchor"},
        "require_reference": {"type": "boolean"}, "keep_pair": {"type": "boolean"}
      }
    },
    "bibliographyEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "language", "author_display", "author_sort", "sort_key_source", "year", "title", "title_sort", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "language": {"$ref": "#/$defs/nonempty"},
        "author_display": {"$ref": "#/$defs/nonempty"}, "author_sort": {"$ref": "#/$defs/nonempty"},
        "sort_key_source": {"$ref": "#/$defs/nonempty"}, "year": {"$ref": "#/$defs/nonempty"},
        "title": {"$ref": "#/$defs/nonempty"}, "title_sort": {"$ref": "#/$defs/nonempty"},
        "text": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
