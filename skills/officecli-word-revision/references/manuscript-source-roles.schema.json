{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable manuscript source-role selectors",
  "type": "object",
  "required": ["schema_version", "source", "paragraph_count", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "paragraph_count": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "role", "text_sha256", "style_id"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "role": {"enum": ["abstract", "keywords", "bibliography_entry"]},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "style_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "bibliography": {
      "type": "object",
      "required": ["heading_index", "end_index"],
      "properties": {
        "heading_index": {"type": "integer", "minimum": 0},
        "end_index": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
